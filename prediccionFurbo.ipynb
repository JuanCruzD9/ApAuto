   "source": [
    "#Imports \n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import TimeSeriesSplit, RandomizedSearchCV\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.naive_bayes import BernoulliNB\n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "ruta = \"futbol_uruguayo.csv\"\n",
    "ds = pd.read_csv(ruta)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cf852ed6",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Preprocesamiento\n",
    "\n",
    "#1. Calculo columna resultado\n",
    "condiciones = [\n",
    "    ds[\"gh\"] > ds[\"ga\"],  # Gana local (G)\n",
    "    ds[\"gh\"] < ds[\"ga\"],  # Gana visitante (P)\n",
    "]\n",
    "opciones = [\"G\", \"P\"]\n",
    "ds[\"resultado\"] = np.select(condiciones, opciones, default=\"E\")\n",
    "ds[\"date\"] = pd.to_datetime(ds[\"date\"])\n",
    "\n",
    "#2. Creacion de nuevas columnas de datos: historial, nivelRelativo \n",
    "def calcular_historial_y_nivel(ds):\n",
    "    # Ordenamos cronológicamente\n",
    "    ds = ds.sort_values(\"date\").copy()\n",
    "\n",
    "    # Nuevas columnas\n",
    "    ds[\"historial\"] = \"Neutro\"\n",
    "    ds[\"nivel_relativo\"] = \"Parejo\"\n",
    "\n",
    "    # Recorremos cada partido\n",
    "    for i, fila in ds.iterrows():\n",
    "\n",
    "        local = fila[\"home_ident\"]\n",
    "        visitante = fila[\"away_ident\"]\n",
    "        fecha = fila[\"date\"]\n",
    "\n",
    "        # -----------------------------------------\n",
    "        # Buscar enfrentamientos anteriores\n",
    "        # entre estos dos equipos\n",
    "        # -----------------------------------------\n",
    "\n",
    "        anteriores = ds.loc[\n",
    "            (ds[\"date\"] < fecha) &\n",
    "            (\n",
    "                ((ds[\"home_ident\"] == local) & (ds[\"away_ident\"] == visitante)) |\n",
    "                ((ds[\"home_ident\"] == visitante) & (ds[\"away_ident\"] == local))\n",
    "            )\n",
    "        ].tail(10)\n",
    "\n",
    "        # Si no hay enfrentamientos anteriores\n",
    "        if len(anteriores) == 0:\n",
    "            continue\n",
    "\n",
    "        victorias = 0\n",
    "        derrotas = 0\n",
    "        goles_favor = []\n",
    "        goles_contra = []\n",
    "\n",
    "        # -----------------------------------------\n",
    "        # Analizamos los últimos enfrentamientos\n",
    "        # desde la perspectiva del equipo LOCAL\n",
    "        # de la fila actual\n",
    "        # -----------------------------------------\n",
    "\n",
    "        for _, partido in anteriores.iterrows():\n",
    "\n",
    "            if (\n",
    "                partido[\"home_ident\"] == local\n",
    "                and partido[\"away_ident\"] == visitante\n",
    "            ):\n",
    "                gf = partido[\"gh\"]\n",
    "                gc = partido[\"ga\"]\n",
    "            else:\n",
    "                # El equipo actual jugó de visitante\n",
    "                gf = partido[\"ga\"]\n",
    "                gc = partido[\"gh\"]\n",
    "\n",
    "            goles_favor.append(gf)\n",
    "            goles_contra.append(gc)\n",
    "\n",
    "            if gf > gc:\n",
    "                victorias += 1\n",
    "            elif gf < gc:\n",
    "                derrotas += 1\n",
    "\n",
    "        # -----------------------------------------\n",
    "        # 1. Historial\n",
    "        # -----------------------------------------\n",
    "\n",
    "        if victorias > derrotas:\n",
    "            ds.at[i, \"historial\"] = \"Positivo\"\n",
    "        elif derrotas > victorias:\n",
    "            ds.at[i, \"historial\"] = \"Negativo\"\n",
    "        else:\n",
    "            ds.at[i, \"historial\"] = \"Neutro\"\n",
    "\n",
    "        # -----------------------------------------\n",
    "        # 2. Nivel relativo (diferencia de forma reciente)\n",
    "        # -----------------------------------------\n",
    "\n",
    "        promedio_gf = sum(goles_favor) / len(goles_favor)\n",
    "        promedio_gc = sum(goles_contra) / len(goles_contra)\n",
    "        diferencia = promedio_gf - promedio_gc\n",
    "\n",
    "        if diferencia <= -1.5:\n",
    "            categoria_nivel = \"Muy_Inferior\"\n",
    "        elif diferencia <= -0.5:\n",
    "            categoria_nivel = \"Inferior\"\n",
    "        elif diferencia < 0.5:\n",
    "            categoria_nivel = \"Parejo\"\n",
    "        elif diferencia < 1.5:\n",
    "            categoria_nivel = \"Superior\"\n",
    "        else:\n",
    "            categoria_nivel = \"Muy_Superior\"\n",
    "\n",
    "        ds.at[i, \"nivel_relativo\"] = categoria_nivel\n",
    "\n",
    "    return ds\n",
    "ds = calcular_historial_y_nivel(ds)\n",
    "\n",
    "#3. Separacion en datos de Entrenamiento y Test\n",
    "mask_test = ds[\"date\"].dt.year >= 2024\n",
    "train = ds[~mask_test]\n",
    "test = ds[mask_test]\n",
    "\n",
    "X_train = train[[\"home_ident\", \"away_ident\", \"historial\", \"nivel_relativo\"]] #Faltan los datos a ser creados\n",
    "y_train = train[\"resultado\"]\n",
    "\n",
    "X_test = test[[\"home_ident\", \"away_ident\", \"historial\", \"nivel_relativo\"]] #Faltan los datos a ser creados\n",
    "y_test = test[\"resultado\"]\n",
    "\n",
    "#Encoding para estimadores sklearn\n",
    "encoder = OneHotEncoder(handle_unknown=\"ignore\")\n",
    "X_train_encoded = encoder.fit_transform(X_train)\n",
    "X_test_encoded = encoder.transform(X_test)\n",
    "\n",
    "tscv = TimeSeriesSplit(n_splits=3) #Con kfoldin habria data leakage \n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 84,
   "id": "04dd605a",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Estimador 1 (sklearn - Random Forest)\n",
    "param_grid_rf = {\n",
    "    \"n_estimators\": [10, 25, 50, 75, 100, 150],\n",
    "    \"max_depth\": [1, 3, 5, 7, None],\n",
    "}\n",
    "\n",
    "random_rf = RandomizedSearchCV(\n",
    "    estimator=RandomForestClassifier(random_state=42),\n",
    "    param_distributions=param_grid_rf,\n",
    "    cv=tscv,\n",
    "    scoring=\"f1_macro\",\n",
    "    n_jobs=-1,\n",
    "    n_iter=24,\n",
    "    random_state=42\n",
    ")\n",
    "random_rf.fit(X_train_encoded, y_train)\n",
    "\n",
    "y_pred_rf = random_rf.predict(X_test_encoded)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 85,
   "id": "b39535d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Estimador 2 (sklearn - Naive Bayes)\n",
    "param_grid_nb = {\"alpha\": [0.01, 0.1, 0.5, 1.0, 2.0]} #Suavizado de Laplace (dependiendo del alpha creo mas o menos instancias de cada partido)\n",
    "\n",
    "random_nb = RandomizedSearchCV(\n",
    "    estimator=BernoulliNB(), \n",
    "    param_distributions=param_grid_nb, \n",
    "    cv=tscv, \n",
    "    scoring=\"f1_macro\",\n",
    "    n_jobs=-1,\n",
    "    n_iter=5,\n",
    "    random_state=42\n",
    ")\n",
    "random_nb.fit(X_train_encoded, y_train)\n",
    "\n",
    "y_pred_nb = random_nb.predict(X_test_encoded)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "25f5a6af",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Estimador 3 (sklearn - ID3)\n",
    "\"\"\"param_grid = [\n",
    "    {\n",
    "        \"criterio\": [\"Ganancia\", \"GainRatio\", \"ImpurityReduction\"],\n",
    "        \"min_gain_info\": [0.0, 0.001, 0.005, 0.01, 0.05, 0.1, 0.2],\n",
    "        \"max_depth\": [1, 3, 5, 10]\n",
    "    }\n",
    "]\"\"\"\n",
    "param_grid_dt = {\n",
    "    \"criterion\": [\"entropy\", \"gini\"],\n",
    "    \"max_depth\": [3, 5, 7, 10, 15, None],  # Controla la profundidad del árbol\n",
    "    \"min_samples_split\": [2, 5, 10, 20],  # Mínimo de muestras para dividir un nodo\n",
    "    \"min_samples_leaf\": [1, 2, 5, 10],  # Mínimo de muestras en una hoja\n",
    "}\n",
    "\n",
    "random_id3 = RandomizedSearchCV(\n",
    "    estimator=DecisionTreeClassifier(), \n",
    "    param_distributions=param_grid_dt, \n",
    "    cv=tscv, \n",
    "    scoring=\"accuracy\",\n",
    "    n_jobs=-1,\n",
    "    n_iter=35,\n",
    "    random_state=42\n",
    ")\n",
    "random_id3.fit(X_train_encoded, y_train)\n",
    "\n",
    "y_pred_id3 = random_id3.predict(X_test_encoded)"
   ]
  },
